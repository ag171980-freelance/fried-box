# Copiar a .env y completar. El .env no va al repositorio.

APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodix
DB_USER=root
DB_PASS=

# Clave con la que se cifran las credenciales de cobro de cada local
# antes de guardarlas en la base. Obligatoria para que el panel acepte
# un token de Mercado Pago: guardarlo en claro no es una opción.
#
# Generar una propia por instalación, nunca reusar la de otra:
#   php -r "echo bin2hex(random_bytes(32));"
#
# Si se cambia, cada local tiene que volver a cargar su token. No se
# pierden pedidos, sólo se deja de poder cobrar hasta recargarlos.
APP_KEY=

# Local que se usa cuando la petición no dice cuál. En producción esto
# no debería existir: cada pedido tiene que traer su tenant.
DEFAULT_TENANT=friedbox

# Orígenes que pueden llamar a la API, separados por coma. Con varias
# marcas en el mismo backend, van todas acá.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Prefijo para las imágenes de los platos. Vacío = rutas relativas, que
# es lo que sirve hoy el front desde su propio public/.
ASSET_BASE_URL=

# Permite marcar pedidos como pagados sin pasarela. Sólo desarrollo.
# Se apaga solo en los locales que ya tienen su cuenta conectada.
ALLOW_FAKE_PAYMENTS=true

# --- Mercado Pago ------------------------------------------------------
# OJO: las credenciales de cobro son de cada local y se cargan desde el
# panel (Local → Cobros), no acá. Se guardan cifradas con APP_KEY.
#
# Las dos claves de abajo quedaron como respaldo de un solo local: el que
# figura en DEFAULT_TENANT, y sólo mientras no haya cargado el suyo desde
# el panel. Existen para que la marca que ya estaba cobrando no se corte
# el día que esto se despliega. Para cualquier otro local no se usan: si
# valieran para todos, una marca nueva sin token configurado cobraría en
# la cuenta de la primera, que es justo lo que esto viene a evitar.
#
# En una instalación nueva, dejarlas vacías.
MP_ACCESS_TOKEN=

MP_WEBHOOK_SECRET=

# A dónde vuelve el cliente después de pagar. Respaldo para los locales
# que no tengan su propio sitio cargado en el panel.
FRONT_URL=http://localhost:5173

# Dirección pública https del backend, para recibir los avisos de pago.
# Cada local recibe los suyos en /t/{slug}/webhooks/mercadopago, armado
# a partir de esta dirección. Vacía en local: ahí la pantalla del pedido
# le pregunta a Mercado Pago cómo salió el pago.
API_PUBLIC_URL=
