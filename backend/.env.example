# Copiar a .env y completar. El .env no va al repositorio.

APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodix
DB_USER=root
DB_PASS=

# Local que se usa cuando la petición no dice cuál. En producción esto
# no debería existir: cada pedido tiene que traer su tenant.
DEFAULT_TENANT=friedbox

# Orígenes que pueden llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Prefijo para las imágenes de los platos. Vacío = rutas relativas, que
# es lo que sirve hoy el front desde su propio public/.
ASSET_BASE_URL=

# Permite marcar pedidos como pagados sin pasarela. Sólo desarrollo.
ALLOW_FAKE_PAYMENTS=true

# --- Mercado Pago ------------------------------------------------------
# Access token de la aplicación (Tus integraciones → Credenciales).
# Uno de prueba empieza con TEST- y cobra en el sandbox. Con esto
# cargado, el pago simulado se apaga solo.
MP_ACCESS_TOKEN=

# Clave secreta de los webhooks (Tus integraciones → Webhooks). Opcional.
MP_WEBHOOK_SECRET=

# A dónde vuelve el cliente después de pagar (el front).
FRONT_URL=http://localhost:5173

# Dirección pública https del backend, para recibir los avisos de pago
# en /webhooks/mercadopago. Vacía en local: ahí la pantalla del pedido
# le pregunta a Mercado Pago cómo salió el pago.
API_PUBLIC_URL=
