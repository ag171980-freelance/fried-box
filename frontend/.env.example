# Copiar a .env.local (que no va al repositorio).

# Base de la API. Por defecto /api, que el proxy de Vite manda al backend.
# VITE_API_URL=/api

# Local a mostrar. Vacío = el DEFAULT_TENANT del backend.
# VITE_TENANT=cafe-rivas

# A dónde manda /api el proxy de Vite.
#   servidor embebido de PHP      http://127.0.0.1:8080   (por defecto)
#   Apache de XAMPP               http://localhost/foodix/backend/public
# VITE_API_PROXY=http://127.0.0.1:8080
